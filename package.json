{
  "name": "mcp-directory-check",
  "version": "0.1.1",
  "description": "Check a remote MCP server against ChatGPT's and Claude's published directory rules. Read-only, no account.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "chatgpt",
    "claude",
    "connector",
    "plugin",
    "directory",
    "lint"
  ],
  "license": "MIT",
  "homepage": "https://transica.dev/tools/mcp-directory-check",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/transica-dev/mcp-directory-check.git"
  },
  "type": "module",
  "bin": {
    "mcp-directory-check": "dist/cli.js"
  },
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "action.yml"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "esbuild src/cli.ts src/index.ts --bundle --platform=node --format=esm --target=node20 --outdir=dist",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
